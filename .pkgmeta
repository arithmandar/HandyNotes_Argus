package-as: HandyNotes_Argus

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain

enable-nolib-creation: no

externals:
    Libs-release/LibBabble-SubZone-3.0:
        url: https://repos.wowace.com/wow/libbabble-subzone-3-0/trunk

move-folders:
    HandyNotes_Argus/Libs: HandyNotes_Argus/Libs-dev
    HandyNotes_Argus/Libs-release: HandyNotes_Argus/Libs

ignore:
    - Images/PSD
    - Libs-dev
